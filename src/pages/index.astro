---
import deals from "../data/deals.json";

const activeDeals = deals.filter((deal) => deal.status === "active");
const expiredDeals = deals.filter((deal) => deal.status === "expired");
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KleingeldPilot – Kleine Beträge smarter nutzen</title>
    <meta
      name="description"
      content="KleingeldPilot hilft dir, kleine Online-Einnahmen sinnvoll zu nutzen, Gebühren zu vermeiden und passende Sparplan- oder Auszahlungswege zu finden."
    />
    <style>
      :root {
        font-family: Arial, sans-serif;
        color: #172033;
        background: #f5f7fb;
      }

      body {
        margin: 0;
      }

      header {
        background: white;
        border-bottom: 1px solid #e5e7eb;
      }

      nav {
        max-width: 1100px;
        margin: 0 auto;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      nav a {
        color: #172033;
        text-decoration: none;
        font-weight: 700;
      }

      .links {
        display: flex;
        gap: 18px;
        font-size: 14px;
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px;
      }

      .hero {
        background: linear-gradient(135deg, #10233f, #2455a6);
        color: white;
        border-radius: 28px;
        padding: 52px 34px;
      }

      .hero h1 {
        font-size: clamp(34px, 6vw, 64px);
        line-height: 1;
        margin: 0 0 18px;
      }

      .hero p {
        max-width: 720px;
        font-size: 19px;
        line-height: 1.6;
        margin: 0 0 26px;
      }

      .button {
        display: inline-block;
        background: #26d07c;
        color: #081426;
        padding: 14px 20px;
        border-radius: 999px;
        font-weight: 800;
        text-decoration: none;
      }

      .section {
        margin-top: 42px;
      }

      .section h2 {
        font-size: 30px;
        margin-bottom: 12px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(245px, 1fr));
        gap: 18px;
      }

      .card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 22px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
      }

      .card h3 {
        margin: 0 0 8px;
      }

      .tag {
        display: inline-block;
        font-size: 12px;
        font-weight: 800;
        padding: 6px 10px;
        border-radius: 999px;
        background: #eef4ff;
        margin-bottom: 12px;
      }

      .expired {
        opacity: 0.62;
      }

      .expired .button {
        background: #d1d5db;
        color: #374151;
        pointer-events: none;
      }

      .note {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        padding: 18px;
        border-radius: 18px;
        line-height: 1.5;
      }

      footer {
        margin-top: 60px;
        padding-top: 24px;
        border-top: 1px solid #e5e7eb;
        color: #64748b;
        font-size: 14px;
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <a href="/">KleingeldPilot</a>
        <div class="links">
          <a href="#angebote">Angebote</a>
          <a href="#strategie">Strategie</a>
          <a href="#hinweis">Hinweis</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Kleine Beträge. Smarte Wege.</h1>
        <p>
          KleingeldPilot zeigt dir, wie du kleine Online-Einnahmen aus Umfragen,
          Apps oder Cashback sinnvoll nutzt, Gebühren vermeidest und passende
          Auszahlungs- oder Sparplanwege findest.
        </p>
        <a class="button" href="#angebote">Aktuelle Angebote ansehen</a>
      </section>

      <section class="section" id="strategie">
        <h2>Worum geht es?</h2>
        <div class="grid">
          <div class="card">
            <span class="tag">1</span>
            <h3>Geld verdienen</h3>
            <p>
              Wir vergleichen Apps, Umfrageseiten und kleine Online-Nebenverdienste.
            </p>
          </div>
          <div class="card">
            <span class="tag">2</span>
            <h3>Gebühren vermeiden</h3>
            <p>
              Besonders bei 5-Euro-Auszahlungen können fixe Gebühren den Gewinn fast komplett auffressen.
            </p>
          </div>
          <div class="card">
            <span class="tag">3</span>
            <h3>Kleine Beträge nutzen</h3>
            <p>
              Statt teurer Einzelorders prüfen wir Sparpläne, PayPal-Auszahlungen und einfache Wege.
            </p>
          </div>
        </div>
      </section>

      <section class="section" id="angebote">
        <h2>Aktuelle Angebote</h2>
        <div class="grid">
          {activeDeals.map((deal) => (
            <article class="card">
              <span class="tag">{deal.category}</span>
              <h3>{deal.title}</h3>
              <p>{deal.description}</p>
              <p><strong>Zuletzt geprüft:</strong> {deal.lastChecked}</p>
              <a class="button" href={deal.url}>{deal.buttonLabel}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>Abgelaufene Angebote</h2>
        <div class="grid">
          {expiredDeals.map((deal) => (
            <article class="card expired">
              <span class="tag">{deal.category}</span>
              <h3>{deal.title}</h3>
              <p>{deal.description}</p>
              <p><strong>Status:</strong> abgelaufen</p>
              <a class="button" href="#">{deal.buttonLabel}</a>
            </article>
          ))}
        </div>
      </section>

      <section class="section note" id="hinweis">
        <strong>Hinweis:</strong> Diese Seite enthält später Affiliate-Links.
        Wenn du über solche Links ein Konto erstellst oder ein Angebot nutzt,
        können wir eine Provision erhalten. Für dich entstehen dadurch keine
        zusätzlichen Kosten. Die Inhalte dienen nur der allgemeinen Information
        und sind keine Anlageberatung.
      </section>

      <footer>
        © 2026 KleingeldPilot · Impressum und Datenschutz werden noch ergänzt.
      </footer>
    </main>
  </body>
</html>